<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <!-- Per-Monitor-V2 DPI aware (see app.manifest) - without this, the projector output blurs whenever
         it's on a display with different scaling than the primary monitor (e.g. a laptop screen at 150%
         and a projector at 100%, a very common real combination). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The WinForms analyzer suggests ApplicationHighDpiMode instead of a manifest - that's the right
         call for a pure WinForms app, but it works through a WinForms-only Application.SetHighDpiMode()
         startup call this app (WPF-driven; WinForms is used only for Screen enumeration) never makes.
         The manifest is Microsoft's own documented way to declare DPI awareness for WPF specifically. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\BookAliases.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Scripture.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\KJV.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Fonts\*.ttf" />
    <Resource Include="Resources\AppIcon.png" />
    <Resource Include="Resources\AppIcon32.png" />
  </ItemGroup>

  <!-- The app reads the bundled Bible and background from Resources beside the exe. Publish doesn't always
       carry these XML/JPG content files across, so copy them explicitly after every publish. -->
  <Target Name="CopyBundledResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <BundledResource Include="Resources\KJV.xml;Resources\Scripture.jpg" />
    </ItemGroup>
    <Copy SourceFiles="@(BundledResource)" DestinationFolder="$(PublishDir)Resources" SkipUnchangedFiles="true" />
  </Target>

</Project>
