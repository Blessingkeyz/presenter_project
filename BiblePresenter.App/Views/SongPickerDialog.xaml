<Window x:Class="BiblePresenter.App.Views.SongPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Song" Icon="pack://application:,,,/BiblePresenter.App;component/Resources/AppIcon32.png" Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/Resources/Styles.xaml" />
    </Window.Resources>

    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Filter by title:" Style="{StaticResource EditorLabel}" />
        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" FontSize="16" Margin="0,0,0,14" VerticalContentAlignment="Center"
                 TextChanged="FilterBox_TextChanged" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Browse for file..." Click="Browse_Click" HorizontalAlignment="Left" />
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="Add" Style="{StaticResource AccentButton}" Click="Add_Click" x:Name="AddButton" IsEnabled="False" Margin="8,0,0,0" />
        </StackPanel>

        <ListBox x:Name="SongsList"
                 SelectionChanged="SongsList_SelectionChanged"
                 MouseDoubleClick="SongsList_MouseDoubleClick" />
    </DockPanel>
</Window>
