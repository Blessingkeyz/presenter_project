<Window x:Class="BiblePresenter.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BiblePresenter.App.Views"
        xmlns:vm="clr-namespace:BiblePresenter.App.ViewModels"
        xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Settings" Icon="pack://application:,,,/BiblePresenter.App;component/Resources/AppIcon32.png" Width="1100" Height="716" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindowFrame}">
    <!-- The title/tab row doubles as the title bar, like the main window's header. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="61" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Window title and the tab switcher share one row, matching the main window's header. -->
            <Style x:Key="SettingsTabs" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                                        BorderThickness="0,0,0,1" Padding="28,0,0,0" Margin="0,0,0,20">
                                    <DockPanel Height="60">
                                        <local:WindowControls DockPanel.Dock="Right" VerticalAlignment="Stretch" />
                                        <TextBlock DockPanel.Dock="Left" Text="{TemplateBinding Tag}"
                                                   FontFamily="pack://application:,,,/Resources/Fonts/#Helvetica LT"
                                                   FontSize="22" Foreground="{StaticResource Parchment}" VerticalAlignment="Center" Margin="0,0,32,0" />
                                        <Border Background="{StaticResource InputBg}" CornerRadius="7" Padding="3"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TabPanel IsItemsHost="True" />
                                        </Border>
                                    </DockPanel>
                                </Border>
                                <ContentPresenter ContentSource="SelectedContent" Margin="28,0,28,14" />
                            </DockPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Section title followed by a hairline rule. -->
            <DataTemplate x:Key="SectionHeader">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Parchment}" />
                    <Border Height="1" Background="{StaticResource Border}" Margin="14,2,0,0" VerticalAlignment="Center" />
                </DockPanel>
            </DataTemplate>

            <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- A background thumbnail in the filmstrip; gold ring when chosen. -->
            <Style x:Key="FilmFrame" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Parchment}" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="ToolTip" Value="{Binding Name}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Frame" Width="128" Height="72" CornerRadius="5" BorderThickness="2"
                                    BorderBrush="{StaticResource InputBorder}" Background="Black" ClipToBounds="True">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FadedInk}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Candle}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sample slide text follows the style being edited. -->
            <Style x:Key="StageText" TargetType="local:OutlinedTextBlock">
                <Setter Property="FontFamily" Value="{Binding FontFamily, Converter={StaticResource FontNameToFontFamily}}" />
                <Setter Property="FontWeight" Value="{Binding Bold, Converter={StaticResource BoolToFontWeight}}" />
                <Setter Property="IsItalic" Value="{Binding Italic}" />
                <Setter Property="IsUnderline" Value="{Binding Underline}" />
                <Setter Property="Fill" Value="{Binding TextColor, Converter={StaticResource HexToBrush}}" />
                <Setter Property="BorderEnabled" Value="{Binding BorderEnabled}" />
                <Setter Property="Stroke" Value="{Binding BorderColor, Converter={StaticResource HexToBrush}}" />
                <Setter Property="HasShadow" Value="{Binding ShadowEnabled}" />
                <Setter Property="ShadowColor" Value="{Binding ShadowColor, Converter={StaticResource HexToBrush}}" />
            </Style>

            <!-- One editor, reused for both the Scripture and Song/Slide tabs. -->
            <DataTemplate x:Key="StyleEditorTemplate" DataType="{x:Type vm:StyleEditorViewModel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="430" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ============ Controls ============ -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,16,0">
                            <ContentControl Content="Typeface" ContentTemplate="{StaticResource SectionHeader}" Margin="0,0,0,12" />

                            <TextBlock Text="Font" Style="{StaticResource EditorLabel}" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Style="{StaticResource EditableComboBox}" Margin="0,0,12,0" VerticalAlignment="Center"
                                          ItemsSource="{x:Static local:BundledFonts.Choices}"
                                          Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource StyleChip}" IsChecked="{Binding Bold}" Content="B" FontWeight="Bold" ToolTip="Bold" />
                                    <ToggleButton Style="{StaticResource StyleChip}" IsChecked="{Binding Italic}" Content="I" FontStyle="Italic" ToolTip="Italic" />
                                    <ToggleButton Style="{StaticResource StyleChip}" IsChecked="{Binding Underline}" ToolTip="Underline" Margin="0">
                                        <TextBlock Text="U" TextDecorations="Underline"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                    </ToggleButton>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Size" Style="{StaticResource EditorLabel}" />
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBox TextAlignment="Center" Text="{Binding TitleFontSize, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Title" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBox TextAlignment="Center" Text="{Binding BodyFontSize, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Body" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBox TextAlignment="Center" Text="{Binding SubtitleFontSize, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Subtitle" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Both tabs: a verse on Scripture, a stanza or slide on Song / Slide. -->
                            <Grid Margin="0,-6,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" TextAlignment="Center" VerticalAlignment="Top"
                                         ToolTip="Characters a verse can run to before it continues on the next slide (40 to 1000)"
                                         Text="{Binding MaxSlideChars, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Text="{Binding SlideLengthHint}" />
                            </Grid>

                            <ContentControl Content="Color and finish" ContentTemplate="{StaticResource SectionHeader}" Margin="0,0,0,12" />

                            <local:ColorSwatchPicker Header="Text" Color="{Binding TextColor, Mode=TwoWay}" Margin="0,0,0,14" />

                            <local:ColorSwatchPicker Color="{Binding BorderColor, Mode=TwoWay}" IsActive="{Binding BorderEnabled}" Margin="0,0,0,14">
                                <local:ColorSwatchPicker.Header>
                                    <CheckBox Content="Border" IsChecked="{Binding BorderEnabled}" Margin="0"
                                              Foreground="{StaticResource FadedInk}" FontSize="12" />
                                </local:ColorSwatchPicker.Header>
                            </local:ColorSwatchPicker>

                            <local:ColorSwatchPicker Color="{Binding ShadowColor, Mode=TwoWay}" IsActive="{Binding ShadowEnabled}">
                                <local:ColorSwatchPicker.Header>
                                    <CheckBox Content="Shadow" IsChecked="{Binding ShadowEnabled}" Margin="0"
                                              Foreground="{StaticResource FadedInk}" FontSize="12" />
                                </local:ColorSwatchPicker.Header>
                            </local:ColorSwatchPicker>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============ Preview + backgrounds ============ -->
                    <StackPanel Grid.Column="2">
                        <!-- 960x540 stage, scaled to the column width: the same canvas the live preview and projector use, so sizes read true. -->
                        <Border CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="Black" ClipToBounds="True">
                            <Viewbox Stretch="Uniform">
                                <Grid Width="960" Height="540">
                                    <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                           gif:ImageBehavior.AnimatedSource="{Binding SelectedBackground.FilePath, Converter={StaticResource PathToImageSource}}" />
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.0" />
                                                <GradientStop Color="#00000000" Offset="0.25" />
                                                <GradientStop Color="#8F000000" Offset="0.55" />
                                                <GradientStop Color="#CC000000" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Grid Margin="60,36">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <local:OutlinedTextBlock Grid.Row="0" Style="{StaticResource StageText}" Text="{Binding SampleTitle}"
                                                                  HorizontalAlignment="Center" TextAlignment="Center"
                                                                  FontSize="{Binding TitleFontSize}" />
                                        <local:OutlinedTextBlock Grid.Row="1" Style="{StaticResource StageText}" Text="{Binding SampleBody}" FitToHeight="True"
                                                                  VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="{Binding BodyAlignment}"
                                                                  FontSize="{Binding BodyFontSize}" />
                                        <local:OutlinedTextBlock Grid.Row="2" Style="{StaticResource StageText}" Text="{Binding SampleSubtitle}"
                                                                  HorizontalAlignment="Center" TextAlignment="Center"
                                                                  FontSize="{Binding SubtitleFontSize}" />
                                    </Grid>
                                </Grid>
                            </Viewbox>
                        </Border>

                        <DockPanel Margin="0,20,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Import..." Style="{StaticResource SmallButton}"
                                        Command="{Binding DataContext.ImportBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Button Content="Remove" Style="{StaticResource SmallButton}" Margin="0"
                                        Command="{Binding DataContext.RemoveBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding SelectedBackground}" />
                            </StackPanel>
                            <ContentControl Content="Background" ContentTemplate="{StaticResource SectionHeader}" Margin="0,0,16,0" VerticalAlignment="Center" />
                        </DockPanel>

                        <ListBox ItemsSource="{Binding DataContext.Backgrounds, RelativeSource={RelativeSource AncestorType=Window}}"
                                 SelectedItem="{Binding SelectedBackground}" ItemContainerStyle="{StaticResource FilmFrame}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 Padding="0,0,0,10">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding FilePath, Converter={StaticResource PathToThumbnail}}" />
                                        <Border VerticalAlignment="Bottom" Padding="7,12,7,4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0" />
                                                    <GradientStop Color="#D8000000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="28,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Click="Cancel_Click" />
                    <Button Content="Save Settings" Style="{StaticResource AccentButton}" Click="Ok_Click" />
                </StackPanel>
                <TextBlock Text="Scripture and Song / Slide each keep their own font, colors and background."
                           Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TabControl Style="{StaticResource SettingsTabs}" Tag="Settings">
            <TabItem Header="Scripture">
                <ContentControl Content="{Binding Scripture}" ContentTemplate="{StaticResource StyleEditorTemplate}" />
            </TabItem>
            <TabItem Header="Song / Slide">
                <ContentControl Content="{Binding Song}" ContentTemplate="{StaticResource StyleEditorTemplate}" />
            </TabItem>
            <TabItem Header="General">
                <StackPanel Width="520" HorizontalAlignment="Left">
                    <ContentControl Content="Projector" ContentTemplate="{StaticResource SectionHeader}" Margin="0,0,0,14" />
                    <TextBlock Text="Choose which monitor the live output window appears on." Style="{StaticResource Caption}" Margin="0,0,0,12" />
                    <ComboBox ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ScreenToLabel}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
