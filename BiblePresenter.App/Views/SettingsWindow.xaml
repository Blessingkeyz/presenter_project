<Window x:Class="BiblePresenter.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BiblePresenter.App.Views"
        xmlns:vm="clr-namespace:BiblePresenter.App.ViewModels"
        xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
        Title="Settings" Width="860" Height="700" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#FF15161A" Foreground="#FFF2F2F5" FontFamily="Segoe UI">
    <Window.Resources>
        <local:FontNameToFontFamilyConverter x:Key="FontNameToFontFamily" />
        <local:HexToBrushConverter x:Key="HexToBrush" />
        <local:BoolToFontWeightConverter x:Key="BoolToFontWeight" />
        <local:PathToImageSourceConverter x:Key="PathToImageSource" />
        <local:ScreenToLabelConverter x:Key="ScreenToLabel" />

        <!-- ===================== Palette (matches MainWindow) ===================== -->
        <SolidColorBrush x:Key="CardBg" Color="#FF1D1E24" />
        <SolidColorBrush x:Key="CardBorder" Color="#FF272932" />
        <SolidColorBrush x:Key="InputBg" Color="#FF212228" />
        <SolidColorBrush x:Key="InputBorder" Color="#FF2E313C" />
        <SolidColorBrush x:Key="PillBg" Color="#FF212228" />
        <SolidColorBrush x:Key="HoverBg" Color="#FF272932" />
        <SolidColorBrush x:Key="SelectedBg" Color="#FF25304A" />
        <SolidColorBrush x:Key="Accent" Color="#FF5B8DEF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF2F2F5" />
        <SolidColorBrush x:Key="TextMuted" Color="#FF9A9DA8" />
        <SolidColorBrush x:Key="TextFaint" Color="#FF6E7079" />

        <x:Array x:Key="ColorPalette" Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
            <sys:String>#FFFFFF</sys:String>
            <sys:String>#000000</sys:String>
            <sys:String>#FFD700</sys:String>
            <sys:String>#E0C060</sys:String>
            <sys:String>#FF0000</sys:String>
            <sys:String>#FFA500</sys:String>
            <sys:String>#00A000</sys:String>
            <sys:String>#3070FF</sys:String>
            <sys:String>#00CFCF</sys:String>
            <sys:String>#CF00CF</sys:String>
            <sys:String>#808080</sys:String>
        </x:Array>

        <!-- ===================== Text ===================== -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>

        <!-- ===================== Buttons ===================== -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FF262832" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF31333F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Accent}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF6E9CF5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== TextBox ===================== -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== ComboBox (non-editable - Projector picker) ===================== -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Background="Transparent"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" IsHitTestVisible="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" IsHitTestVisible="False"
                                                       Content="{TemplateBinding SelectionBoxItem}"
                                                       ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                       Margin="{TemplateBinding Padding}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <Path Grid.Column="1" Data="M0,0 L6,6 L12,0" Stroke="{StaticResource TextMuted}"
                                          StrokeThickness="1.4" Margin="0,0,10,0" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource InputBorder}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" MaxHeight="320"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== Editable ComboBox (Font / color pickers - text box + separate arrow, no overlap) ===================== -->
        <Style x:Key="EditableComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="IsEditable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                         Background="Transparent" Foreground="{TemplateBinding Foreground}"
                                         CaretBrush="{TemplateBinding Foreground}" BorderThickness="0"
                                         Padding="{TemplateBinding Padding}" VerticalContentAlignment="Center" />

                                <ToggleButton x:Name="Toggle" Grid.Column="1" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <Path Data="M0,0 L6,6 L12,0" Stroke="{StaticResource TextMuted}"
                                                      StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Popup x:Name="Popup" Grid.ColumnSpan="2" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource InputBorder}"
                                            BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" MaxHeight="240"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== CheckBox ===================== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" Background="{StaticResource InputBg}"
                                    BorderBrush="{StaticResource InputBorder}" BorderThickness="1" Margin="0,0,8,0">
                                <Path x:Name="Check" Data="M2,6 L6,10 L12,2" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== TabControl / TabItem (segmented pill headers) ===================== -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{StaticResource PillBg}" CornerRadius="9" Padding="3"
                                    HorizontalAlignment="Left" Margin="0,0,0,16">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== ListBox (Background picker) ===================== -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shows an actual color swatch (not just the hex text) for each item in a color dropdown. -->
        <DataTemplate x:Key="ColorItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Width="16" Height="16" CornerRadius="4" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" Margin="0,0,8,0"
                        Background="{Binding Converter={StaticResource HexToBrush}}" />
                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- Live swatch of whatever color is currently selected/typed, placed next to each color ComboBox. -->
        <Style x:Key="ColorSwatch" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One editor form, reused for both the Scripture and Song/Slide tabs. -->
        <DataTemplate x:Key="StyleEditorTemplate" DataType="{x:Type vm:StyleEditorViewModel}">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,10,4">
                    <TextBlock Text="Font" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                    <ComboBox x:Name="FontBox" Style="{StaticResource EditableComboBox}"
                              Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Sizes (Title / Body / Subtitle)" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="64" Text="{Binding TitleFontSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <TextBox Width="64" Text="{Binding BodyFontSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <TextBox Width="64" Text="{Binding SubtitleFontSize, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <TextBlock Text="Style" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="Bold" IsChecked="{Binding Bold}" />
                        <CheckBox Content="Italic" IsChecked="{Binding Italic}" />
                        <CheckBox Content="Underline" IsChecked="{Binding Underline}" Margin="0" />
                    </StackPanel>

                    <TextBlock Text="Text color" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Style="{StaticResource EditableComboBox}" Width="150" Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{StaticResource ColorPalette}" ItemTemplate="{StaticResource ColorItemTemplate}" />
                        <Border Style="{StaticResource ColorSwatch}" Background="{Binding TextColor, Converter={StaticResource HexToBrush}}" />
                    </StackPanel>

                    <TextBlock Text="Border" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="Enabled" IsChecked="{Binding BorderEnabled}" Margin="0,0,12,0" />
                        <ComboBox Style="{StaticResource EditableComboBox}" Width="130" Text="{Binding BorderColor, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{StaticResource ColorPalette}" ItemTemplate="{StaticResource ColorItemTemplate}" />
                        <Border Style="{StaticResource ColorSwatch}" Background="{Binding BorderColor, Converter={StaticResource HexToBrush}}" />
                    </StackPanel>

                    <TextBlock Text="Shadow" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="Enabled" IsChecked="{Binding ShadowEnabled}" Margin="0,0,12,0" />
                        <ComboBox Style="{StaticResource EditableComboBox}" Width="130" Text="{Binding ShadowColor, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{StaticResource ColorPalette}" ItemTemplate="{StaticResource ColorItemTemplate}" />
                        <Border Style="{StaticResource ColorSwatch}" Background="{Binding ShadowColor, Converter={StaticResource HexToBrush}}" />
                    </StackPanel>

                    <TextBlock Text="Background" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="Only used for this tab's content - Scripture and Song/Slide can each use a different background."
                               Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="8" Padding="6">
                        <ListBox Height="120" Background="Transparent" BorderThickness="0"
                                 ItemsSource="{Binding DataContext.Backgrounds, RelativeSource={RelativeSource AncestorType=Window}}"
                                 SelectedItem="{Binding SelectedBackground}" DisplayMemberPath="Name" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                        <Button Content="Import..." Command="{Binding DataContext.ImportBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="Remove" Command="{Binding DataContext.RemoveBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding SelectedBackground}" Margin="0" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="2" Background="Black" CornerRadius="12" ClipToBounds="True"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <Grid>
                        <Image Stretch="UniformToFill"
                               gif:ImageBehavior.AnimatedSource="{Binding SelectedBackground.FilePath, Converter={StaticResource PathToImageSource}}" />
                        <StackPanel VerticalAlignment="Center" Margin="16">
                            <local:OutlinedTextBlock Text="Sample Title" HorizontalAlignment="Center" TextAlignment="Center"
                                                      FontFamily="{Binding FontFamily, Converter={StaticResource FontNameToFontFamily}}"
                                                      FontWeight="{Binding Bold, Converter={StaticResource BoolToFontWeight}}"
                                                      IsItalic="{Binding Italic}" IsUnderline="{Binding Underline}"
                                                      Fill="{Binding TextColor, Converter={StaticResource HexToBrush}}"
                                                      BorderEnabled="{Binding BorderEnabled}" Stroke="{Binding BorderColor, Converter={StaticResource HexToBrush}}"
                                                      HasShadow="{Binding ShadowEnabled}" ShadowColor="{Binding ShadowColor, Converter={StaticResource HexToBrush}}"
                                                      FontSize="24" Margin="0,0,0,10" />
                            <local:OutlinedTextBlock Text="This is a sample slide. This text is the body text." HorizontalAlignment="Center" TextAlignment="Center"
                                                      FontFamily="{Binding FontFamily, Converter={StaticResource FontNameToFontFamily}}"
                                                      FontWeight="{Binding Bold, Converter={StaticResource BoolToFontWeight}}"
                                                      IsItalic="{Binding Italic}" IsUnderline="{Binding Underline}"
                                                      Fill="{Binding TextColor, Converter={StaticResource HexToBrush}}"
                                                      BorderEnabled="{Binding BorderEnabled}" Stroke="{Binding BorderColor, Converter={StaticResource HexToBrush}}"
                                                      HasShadow="{Binding ShadowEnabled}" ShadowColor="{Binding ShadowColor, Converter={StaticResource HexToBrush}}"
                                                      FontSize="30" Margin="0,0,0,10" />
                            <local:OutlinedTextBlock Text="Sample Subtitle" HorizontalAlignment="Center" TextAlignment="Center"
                                                      FontFamily="{Binding FontFamily, Converter={StaticResource FontNameToFontFamily}}"
                                                      FontWeight="{Binding Bold, Converter={StaticResource BoolToFontWeight}}"
                                                      IsItalic="{Binding Italic}" IsUnderline="{Binding Underline}"
                                                      Fill="{Binding TextColor, Converter={StaticResource HexToBrush}}"
                                                      BorderEnabled="{Binding BorderEnabled}" Stroke="{Binding BorderColor, Converter={StaticResource HexToBrush}}"
                                                      HasShadow="{Binding ShadowEnabled}" ShadowColor="{Binding ShadowColor, Converter={StaticResource HexToBrush}}"
                                                      FontSize="18" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="Save Settings" Style="{StaticResource AccentButton}" Click="Ok_Click" />
        </StackPanel>

        <TabControl>
            <TabItem Header="Scripture">
                <ContentControl Content="{Binding Scripture}" ContentTemplate="{StaticResource StyleEditorTemplate}" />
            </TabItem>
            <TabItem Header="Song / Slide">
                <ContentControl Content="{Binding Song}" ContentTemplate="{StaticResource StyleEditorTemplate}" />
            </TabItem>
            <TabItem Header="General">
                <StackPanel Margin="4,8,0,0">
                    <TextBlock Text="PROJECTOR" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10" />
                    <TextBlock Text="Choose which monitor the live output window appears on." Foreground="{StaticResource TextFaint}" FontSize="12" Margin="0,0,0,12" />
                    <ComboBox Width="420" HorizontalAlignment="Left" ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ScreenToLabel}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
