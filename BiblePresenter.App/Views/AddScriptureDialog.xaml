<Window x:Class="BiblePresenter.App.Views.AddScriptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Scripture" Icon="pack://application:,,,/BiblePresenter.App;component/Resources/AppIcon32.png" Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/Resources/Styles.xaml" />
    </Window.Resources>

    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Translation" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="TranslationBox" Width="140" HorizontalAlignment="Left"
                      SelectionChanged="TranslationBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Abbreviation}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="Search (e.g. &quot;Psalms 126:1-6&quot; or a keyword):" Style="{StaticResource EditorLabel}" />
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" FontSize="16" Margin="0,0,0,14" VerticalContentAlignment="Center"
                 TextChanged="SearchBox_TextChanged" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="Add" Style="{StaticResource AccentButton}" Click="Add_Click" x:Name="AddButton" IsEnabled="False" Margin="8,0,0,0" />
        </StackPanel>

        <ListBox x:Name="ResultsList"
                 SelectionChanged="ResultsList_SelectionChanged"
                 MouseDoubleClick="ResultsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Reference}" FontWeight="SemiBold" Foreground="{StaticResource Candle}" />
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource FadedInk}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
