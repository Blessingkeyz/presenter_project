<Window x:Class="BiblePresenter.App.Views.AddScriptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Scripture" Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1F24" Foreground="White">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="#FF33353D" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE8E8EA" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Search (e.g. &quot;Psalms 126:1-6&quot; or a keyword):" Margin="0,0,0,6" />
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" FontSize="16" Padding="8,6" Margin="0,0,0,10"
                 Background="#FF2A2C33" Foreground="White" BorderThickness="0"
                 TextChanged="SearchBox_TextChanged" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="Add" Click="Add_Click" Background="#FF3E7D3E" x:Name="AddButton" IsEnabled="False" />
        </StackPanel>

        <ListBox x:Name="ResultsList" Background="#FF25262C" Foreground="White" BorderThickness="0"
                 SelectionChanged="ResultsList_SelectionChanged"
                 MouseDoubleClick="ResultsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="6,4">
                        <TextBlock Text="{Binding Reference}" FontWeight="Bold" Foreground="#FFE0C060" />
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
