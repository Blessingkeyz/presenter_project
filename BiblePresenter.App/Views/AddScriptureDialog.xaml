<Window x:Class="BiblePresenter.App.Views.AddScriptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Scripture" Icon="pack://application:,,,/BiblePresenter.App;component/Resources/AppIcon32.png" Width="820" Height="560" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/Resources/Styles.xaml" />
    </Window.Resources>

    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Translation" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="TranslationBox" Width="140" HorizontalAlignment="Left" Margin="0,0,16,0"
                      SelectionChanged="TranslationBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Abbreviation}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Type a reference/keyword, or tap through Book -> Chapter -> Verse with no typing at all. -->
            <Border Style="{StaticResource Pill}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SearchModeRadio" Content="Search" Style="{StaticResource SegmentToggle}" GroupName="AddScriptureFindBy"
                                 IsChecked="True" Checked="FindByMode_Changed" />
                    <RadioButton x:Name="BrowseModeRadio" Content="Browse" Style="{StaticResource SegmentToggle}" GroupName="AddScriptureFindBy"
                                 Checked="FindByMode_Changed" />
                </StackPanel>
            </Border>
        </DockPanel>

        <StackPanel x:Name="SearchPanel" DockPanel.Dock="Top">
            <TextBlock Text="Search (e.g. &quot;Psalms 126:1-6&quot; or a keyword):" Style="{StaticResource EditorLabel}" />
            <TextBox x:Name="SearchBox" FontSize="16" Margin="0,0,0,14" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="Add" Style="{StaticResource AccentButton}" Click="Add_Click" x:Name="AddButton" IsEnabled="False" Margin="8,0,0,0" />
        </StackPanel>

        <ListBox x:Name="ResultsList"
                 SelectionChanged="ResultsList_SelectionChanged"
                 MouseDoubleClick="ResultsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Reference}" FontWeight="SemiBold" Foreground="{StaticResource Candle}" />
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource FadedInk}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Browse: book list, then chapter grid, then verse grid - tap through, no typing. Hidden until "Browse" is picked above. -->
        <Grid x:Name="BrowsePanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="BOOK" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                <ListBox x:Name="BrowseBookList" DisplayMemberPath="Name" ItemContainerStyle="{StaticResource BrowseBookListItem}"
                         Background="Transparent" BorderThickness="0" SelectionChanged="BrowseBookList_SelectionChanged" />
            </DockPanel>

            <Border Grid.Column="1" Width="1" Background="{StaticResource Border}" Margin="18,0" />

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="CHAPTER" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                <TextBlock x:Name="ChapterHint" DockPanel.Dock="Top" Text="Pick a book first" Style="{StaticResource Caption}" FontStyle="Italic" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="BrowseChapterList" Style="{StaticResource NumberGridListBox}" ItemContainerStyle="{StaticResource NumberGridItem}"
                             SelectionChanged="BrowseChapterList_SelectionChanged" />
                </ScrollViewer>
            </DockPanel>

            <Border Grid.Column="3" Width="1" Background="{StaticResource Border}" Margin="18,0" />

            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="VERSE" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                <TextBlock x:Name="VerseHint" DockPanel.Dock="Top" Text="Pick a chapter first" Style="{StaticResource Caption}" FontStyle="Italic" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="BrowseVerseList" Style="{StaticResource NumberGridListBox}" ItemContainerStyle="{StaticResource NumberGridItem}"
                             SelectionMode="Extended"
                             SelectionChanged="BrowseVerseList_SelectionChanged" MouseDoubleClick="ResultsList_MouseDoubleClick"
                             PreviewMouseLeftButtonDown="BrowseVerseList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="BrowseVerseList_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="BrowseVerseList_PreviewMouseLeftButtonUp" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
