<Window x:Class="BiblePresenter.App.Views.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
        xmlns:local="clr-namespace:BiblePresenter.App.Views"
        Title="Projector Output" Background="Black"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowInTaskbar="False">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <local:PathToImageSourceConverter x:Key="PathToImageSource" />
        <local:FontNameToFontFamilyConverter x:Key="FontNameToFontFamily" />
        <local:HexToBrushConverter x:Key="HexToBrush" />
        <local:BoolToFontWeightConverter x:Key="BoolToFontWeight" />

        <Style TargetType="local:OutlinedTextBlock">
            <Setter Property="FontFamily" Value="{Binding FontFamilyName, Converter={StaticResource FontNameToFontFamily}}" />
            <Setter Property="FontWeight" Value="{Binding IsBold, Converter={StaticResource BoolToFontWeight}}" />
            <Setter Property="IsItalic" Value="{Binding IsItalic}" />
            <Setter Property="IsUnderline" Value="{Binding IsUnderline}" />
            <Setter Property="Fill" Value="{Binding TextColor, Converter={StaticResource HexToBrush}}" />
            <Setter Property="BorderEnabled" Value="{Binding BorderEnabled}" />
            <Setter Property="Stroke" Value="{Binding BorderColor, Converter={StaticResource HexToBrush}}" />
            <Setter Property="BorderSize" Value="{Binding BorderSize}" />
            <Setter Property="HasShadow" Value="{Binding ShadowEnabled}" />
            <Setter Property="ShadowColor" Value="{Binding ShadowColor, Converter={StaticResource HexToBrush}}" />
            <Setter Property="ShadowDistance" Value="{Binding ShadowDistance}" />
            <Setter Property="ShadowAngle" Value="{Binding ShadowAngle}" />
            <Setter Property="ShadowThickness" Value="{Binding ShadowThickness}" />
        </Style>
    </Window.Resources>

    <Grid Visibility="{Binding IsBlank, Converter={StaticResource InverseBoolToVisibility}}">
        <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
               gif:ImageBehavior.AnimatedSource="{Binding CurrentBackground.FilePath, Converter={StaticResource PathToImageSource}}" />

        <!-- No dark scrim here on purpose: the outlined text (see OutlinedTextBlock) carries its own contrast
             against the background, the way OpenSong's does, instead of dimming the photo to compensate. -->

        <!-- Shown at once when the window opens; later slide changes fade in (see OutputWindow.xaml.cs). -->
        <Grid x:Name="TextPanel" Margin="60,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:OutlinedTextBlock Grid.Row="0"
                                      Text="{Binding TopText}"
                                      SecondaryText="{Binding TopSecondaryText}"
                                      SecondaryFontSize="{Binding SubtitleFontSize}"
                                      HorizontalAlignment="Center" TextAlignment="Center"
                                      FontSize="{Binding TitleFontSize}" />

            <local:OutlinedTextBlock Grid.Row="1"
                                      Text="{Binding BodyText}" FitToHeight="True"
                                      VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                      TextAlignment="{Binding BodyAlignment}"
                                      FontSize="{Binding BodyFontSize}" />

            <local:OutlinedTextBlock Grid.Row="2"
                                      Text="{Binding BottomText}"
                                      HorizontalAlignment="Center" TextAlignment="Center"
                                      FontSize="{Binding SubtitleFontSize}" />
        </Grid>

        <!-- An Image item (e.g. an event flyer): the whole picture, fitted to the screen on black, covering everything above. -->
        <Grid Background="Black" Visibility="{Binding HasSlideImage, Converter={StaticResource BoolToVisibility}}">
            <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   gif:ImageBehavior.AnimatedSource="{Binding SlideImagePath, Converter={StaticResource PathToImageSource}}" />
        </Grid>
    </Grid>
</Window>
