<Window x:Class="BiblePresenter.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
        xmlns:local="clr-namespace:BiblePresenter.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Beacon Worship" Icon="pack://application:,,,/BiblePresenter.App;component/Resources/AppIcon32.png" Height="700" Width="1180" MinWidth="980" MinHeight="560"
        Style="{StaticResource AppWindowFrame}" WindowStartupLocation="CenterScreen">
    <!-- The header row doubles as the title bar: no separate native caption, so the window controls live beside Settings. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="63" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/Resources/Styles.xaml" />
    </Window.Resources>
    <!-- Escape stops the projector from anywhere in the window, search box included. F5 and Ctrl+P both
         present the current selection - same action as the Go Live/Present button - from anywhere too.
         Function keys and Ctrl-combos never land inside a textbox as typed characters, unlike a bare
         letter key, so neither can misfire while typing a search query. -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
        <KeyBinding Key="F5" Command="{Binding GoLiveOrPresentCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding GoLiveOrPresentCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================= Header ============================= -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="20,13,0,13">
            <DockPanel LastChildFill="True">
                <local:WindowControls DockPanel.Dock="Right" VerticalAlignment="Stretch" Margin="10,-13,0,-13" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Image Source="pack://application:,,,/Resources/AppIcon.png" Width="26" Height="26"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0" />
                    <TextBlock Text="Beacon Worship" FontFamily="pack://application:,,,/Resources/Fonts/#Helvetica LT"
                               FontSize="19" Foreground="{StaticResource Parchment}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Command="{Binding OpenSettingsCommand}" ToolTip="Settings" AutomationProperties.Name="Settings" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Live status: moved here from the old bottom console strip so that strip could become a slim side rail. -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource Live}" Margin="0,0,8,0"
                            Visibility="{Binding Output.IsBlank, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Text="LIVE" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Live}" VerticalAlignment="Center"
                               Visibility="{Binding Output.IsBlank, Converter={StaticResource InverseBoolToVisibility}}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource FadedInk}"
                               FontSize="12" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Search" Style="{StaticResource SegmentToggle}" GroupName="MainMode"
                                     IsChecked="{Binding IsSetMode, Converter={StaticResource InverseBool}}" />
                        <RadioButton Content="Sets" Style="{StaticResource SegmentToggle}" GroupName="MainMode"
                                     IsChecked="{Binding IsSetMode}" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ============================= Body ============================= -->
        <Grid Grid.Row="1" Margin="24,18,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition x:Name="LiveRailColumn" Width="220" MinWidth="176" MaxWidth="420" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Search bar (Search Mode only) -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18" Visibility="{Binding IsSetMode, Converter={StaticResource InverseBoolToVisibility}}">
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="+ New song"
                            Command="{Binding NewSongCommand}" ToolTip="Create a new song in your library"
                            VerticalAlignment="Center" Margin="0"
                            Visibility="{Binding IsSongSearch, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"
                                Visibility="{Binding IsSongSearch, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="Translation" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="TranslationBox" Width="130" Margin="0" ItemsSource="{Binding TranslationPickerItems}"
                                  SelectedItem="{Binding SelectedTranslation, Mode=OneWay}"
                                  SelectionChanged="TranslationBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Abbreviation}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource Pill}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Bible" Style="{StaticResource SegmentToggle}" GroupName="SearchScope"
                                             IsChecked="{Binding IsSongSearch, Converter={StaticResource InverseBool}}" />
                                <RadioButton Content="Songs" Style="{StaticResource SegmentToggle}" GroupName="SearchScope"
                                             IsChecked="{Binding IsSongSearch}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Pill}" Visibility="{Binding IsSongSearch, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="By Title" Style="{StaticResource SegmentToggle}" GroupName="SongSearchBy"
                                             IsChecked="{Binding SearchSongsByLyrics, Converter={StaticResource InverseBool}}" />
                                <RadioButton Content="By Lyrics" Style="{StaticResource SegmentToggle}" GroupName="SongSearchBy"
                                             IsChecked="{Binding SearchSongsByLyrics}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="7">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="14,0,0,0" />
                        <TextBox x:Name="SearchBox" FontSize="16" Padding="10,12" Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchBox_KeyDown" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="1">
                <!-- Search Mode: results sit on the canvas, no card chrome -->
                <Grid Visibility="{Binding IsSetMode, Converter={StaticResource InverseBoolToVisibility}}">
                    <!-- Watermark: grounds the reserved results canvas so a short result list doesn't read as a dead/broken void. -->
                    <Image Source="pack://application:,,,/BiblePresenter.App;component/Resources/AppIcon.png"
                           Width="220" Height="220" Opacity="0.035" IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <ListBox x:Name="ResultsList"
                             Visibility="{Binding IsSongSearch, Converter={StaticResource InverseBoolToVisibility}}"
                             ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResult}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             MouseDoubleClick="ResultsList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Reference}" FontWeight="SemiBold" Foreground="{StaticResource Candle}" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource FadedInk}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Visibility="{Binding IsSongSearch, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="SongResultsList" Grid.Column="0"
                                 ItemsSource="{Binding SongResults}" SelectedItem="{Binding SelectedSongResult}"
                                 DisplayMemberPath="Title"
                                 MouseDoubleClick="ResultsList_MouseDoubleClick" />

                        <Border Grid.Column="1" Width="1" Background="{StaticResource Border}" Margin="14,0" />

                        <!-- Lyrics preview, so two similarly-titled songs are easy to tell apart before going live. -->
                        <DockPanel Grid.Column="2" Margin="14,0,0,0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="Edit" Padding="14,6" FontSize="12" Margin="12,0,0,0"
                                        VerticalAlignment="Top" Command="{Binding EditPreviewedSongCommand}"
                                        AutomationProperties.Name="Edit song">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PreviewedSong}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Text="{Binding PreviewedSong.Title}" FontWeight="SemiBold"
                                           FontSize="17" Foreground="{StaticResource Candle}" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewedSong.Subtitle}" Foreground="{StaticResource FadedInk}" Margin="0,0,0,16" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl>
                                    <ItemsControl.ItemsSource>
                                        <MultiBinding Converter="{StaticResource SlidesWithLabels}">
                                            <Binding Path="PreviewedSong.Slides" />
                                            <Binding Path="PreviewedSong.SlideLabels" />
                                        </MultiBinding>
                                    </ItemsControl.ItemsSource>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Clicking a card jumps the live output straight to that section - a no-op (and visibly
                                                 dimmed) unless this song is the one actually on screen right now. -->
                                            <Button Style="{StaticResource LiveAwareSlideCardButton}"
                                                    Command="{Binding DataContext.JumpToSlideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Index}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Candle}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Label}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource Parchment}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>

                    <!-- Empty state: fills the leftover canvas with an intentional hint instead of bare black space. -->
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               MaxWidth="360" FontSize="14" Foreground="{StaticResource Faint}" TextWrapping="Wrap">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource SearchEmptyStateVisibility}">
                                <Binding Path="IsSongSearch" />
                                <Binding Path="SearchResults.Count" />
                                <Binding Path="SongResults.Count" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource SearchEmptyStateMessage}">
                                <Binding Path="SearchText" />
                                <Binding Path="IsSongSearch" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>

                <!-- Set Mode: set list (item editing happens in a modal - see EditSetItemDialog) -->
                <DockPanel Visibility="{Binding IsSetMode, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Button Content="File" Click="SetFileMenu_Click" HorizontalAlignment="Left">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Create new set" Command="{Binding NewSetCommand}" />
                                    <MenuItem Header="Rename" Command="{Binding RenameSetCommand}" />
                                    <MenuItem Header="Save As" Command="{Binding SaveSetAsCommand}" />
                                    <MenuItem Header="Delete" Command="{Binding DeleteSetCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <ComboBox Width="200" HorizontalAlignment="Left" ItemsSource="{Binding Sets}" SelectedItem="{Binding SelectedSet}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Add items  &#x25BE;" Click="SetFileMenu_Click" AutomationProperties.Name="Add items" HorizontalAlignment="Left" Margin="0,0,10,0">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Song" Command="{Binding AddSongItemCommand}" />
                                    <MenuItem Header="Scripture" Command="{Binding AddScriptureItemCommand}" />
                                    <MenuItem Header="Custom" Command="{Binding AddCustomItemCommand}" />
                                    <MenuItem Header="Image" Command="{Binding AddImageItemCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <!-- Starts the whole set live from its first item. After this (or after presenting any one
                             item directly), the set is "running" - clicking any other item in the list jumps
                             straight to it, no separate Present click needed. The button itself becomes
                             "End Presentation" while running, taking over for the right rail's Stop. -->
                        <Button Style="{StaticResource PresentSetButton}" Command="{Binding PresentSetCommand}"
                                HorizontalAlignment="Left" Margin="0" />
                    </DockPanel>

                    <!-- Same two-pane shape as song search: the list on the left, the selected item's detail on the right. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="SetListHost" Grid.Column="0">
                            <!-- Drag an item to reorder it; the x at its right removes it (after a warning). -->
                            <ListBox x:Name="SetItemsListBox" ItemsSource="{Binding CurrentSetItems}" SelectedItem="{Binding SelectedSetItem}"
                                     AllowDrop="True" MouseDoubleClick="SetItemsList_MouseDoubleClick"
                                     PreviewMouseLeftButtonDown="SetItems_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="SetItems_PreviewMouseMove"
                                     DragOver="SetItems_DragOver" DragLeave="SetItems_DragLeave" Drop="SetItems_Drop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource InputBg}" CornerRadius="4" Padding="7,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Type}" Foreground="{StaticResource Candle}" FontWeight="SemiBold" FontSize="11" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource RemoveXButton}"
                                                    ToolTip="Remove from set" AutomationProperties.Name="Remove"
                                                    Command="{Binding DataContext.RemoveSetItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Where a dragged item will land. -->
                            <Border x:Name="DropIndicator" Height="2" VerticalAlignment="Top" CornerRadius="1" Margin="0,0,14,0"
                                    Background="{StaticResource Candle}" IsHitTestVisible="False" Visibility="Collapsed" />

                            <TextBlock Text="This set is empty. Use Add items above to put a song, scripture, custom slide or image here."
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="260" FontSize="14" Foreground="{StaticResource Faint}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSetItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Border Grid.Column="1" Width="1" Background="{StaticResource Border}" Margin="14,0" />

                        <!-- Detail of the selected item: its title, subtitle and every slide, so you can check it before presenting. -->
                        <Grid Grid.Column="2" Margin="14,0,0,0" DataContext="{Binding SelectedSetItem}">
                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <!-- Scripture is the Bible's own text, so it isn't editable; everything else is. -->
                                    <Button DockPanel.Dock="Right" Content="Edit" Padding="14,6" FontSize="12" Margin="12,0,0,0"
                                            VerticalAlignment="Top" Click="EditItem_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Scripture">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Border DockPanel.Dock="Left" Background="{StaticResource InputBg}" CornerRadius="4" Padding="7,3"
                                            Margin="0,3,10,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Type}" Foreground="{StaticResource Candle}" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="17"
                                               Foreground="{StaticResource Candle}" TextWrapping="Wrap" />
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Subtitle}" Foreground="{StaticResource FadedInk}" Margin="0,0,0,16" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Grid>
                                        <!-- Text slides (scripture, song, custom) -->
                                        <ItemsControl>
                                            <ItemsControl.ItemsSource>
                                                <MultiBinding Converter="{StaticResource SlidesWithLabels}">
                                                    <Binding Path="Slides" />
                                                    <Binding Path="SlideLabels" />
                                                </MultiBinding>
                                            </ItemsControl.ItemsSource>
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Image">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Clicking a card jumps the live output straight to that section - a no-op (and visibly
                                                         dimmed) unless this item is the one actually on screen right now. -->
                                                    <Button Style="{StaticResource LiveAwareSlideCardButton}"
                                                            Command="{Binding DataContext.JumpToSlideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Index}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource Candle}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Label}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource Parchment}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Image items: the pictures themselves -->
                                        <ItemsControl ItemsSource="{Binding Slides}">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Image">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Black" CornerRadius="6" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" Margin="0,0,0,8">
                                                        <Image Stretch="Uniform" MaxHeight="320" RenderOptions.BitmapScalingMode="HighQuality"
                                                               Source="{Binding Converter={StaticResource PathToThumbnail}, ConverterParameter=720}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </DockPanel>

                            <TextBlock Text="Select an item to see its details." HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="14" Foreground="{StaticResource Faint}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Grid>
            </Grid>

            <!-- ============================= Live rail ============================= -->
            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1,0,0,0" Margin="0,0,-24,0" Padding="16,20">
                <StackPanel VerticalAlignment="Top">
                    <!-- Mini preview: shows what Go Live / Present / Next is about to put on screen, before it's committed.
                         The whole box - background, text, border and all - is designed at the projector's own 960x540
                         (16:9) shape and scaled as one unit by this Viewbox, so dragging the rail wider also makes it
                         taller in proportion, instead of just stretching a fixed-height box sideways. -->
                    <Viewbox Stretch="Uniform" Margin="0,0,0,16">
                        <!-- Border/corner/inset values are scaled up ~5x from how they'd read at the box's real
                             on-screen size, since this whole Border is designed at 960x540 and shrunk by the
                             Viewbox above - without that, a "1px" border would shrink to a sub-pixel hairline. -->
                        <Border Width="960" Height="540" Background="Black" CornerRadius="20" ClipToBounds="True"
                                BorderBrush="{StaticResource InputBorder}" BorderThickness="5">
                        <Grid DataContext="{Binding Preview}">
                            <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                   gif:ImageBehavior.AnimatedSource="{Binding CurrentBackground.FilePath, Converter={StaticResource PathToImageSource}}" />
                            <!-- No dark scrim: matches the projector, which relies on the outlined text's own contrast. -->
                            <Viewbox Stretch="Uniform" Margin="16">
                                <Grid Width="960" Height="540">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <local:OutlinedTextBlock Grid.Row="0" Text="{Binding TopText}"
                                                              SecondaryText="{Binding TopSecondaryText}"
                                                              SecondaryFontSize="{Binding SubtitleFontSize}"
                                                              Style="{StaticResource PreviewOutlinedText}"
                                                              HorizontalAlignment="Center" TextAlignment="Center"
                                                              FontSize="{Binding TitleFontSize}" />

                                    <local:OutlinedTextBlock Grid.Row="1" Text="{Binding BodyText}" FitToHeight="True"
                                                              Style="{StaticResource PreviewOutlinedText}"
                                                              VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                              TextAlignment="{Binding BodyAlignment}"
                                                              FontSize="{Binding BodyFontSize}" />

                                    <local:OutlinedTextBlock Grid.Row="2" Text="{Binding BottomText}"
                                                              Style="{StaticResource PreviewOutlinedText}"
                                                              HorizontalAlignment="Center" TextAlignment="Center"
                                                              FontSize="{Binding SubtitleFontSize}" />
                                </Grid>
                            </Viewbox>

                            <!-- An Image item: the picture itself, fitted, covering the text preview. -->
                            <Grid Background="Black" Visibility="{Binding HasSlideImage, Converter={StaticResource BoolToVisibility}}">
                                <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding SlideImagePath, Converter={StaticResource PathToThumbnail}}" />
                            </Grid>
                        </Grid>
                        </Border>
                    </Viewbox>

                    <!-- Always sends the current selection live - switching items while something is already on screen is one click, not Stop then Go Live.
                         The label itself says which: "Go Live"/"Present" before anything's on screen, "Show Verse"/"Show Item" once something is,
                         so it never reads as "start over" when it's actually "switch to this instead". Hidden entirely once the set is running
                         (IsSetRunning) - clicking any item in the list is the only action needed then, and this button would always be disabled
                         anyway, so leaving it visible would read as "you still need to click this too". -->
                    <Button Style="{StaticResource AccentButton}" Command="{Binding GoLiveOrPresentCommand}"
                            Visibility="{Binding IsSetRunning, Converter={StaticResource InverseBoolToVisibility}}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,10">
                        <Button.Content>
                            <MultiBinding Converter="{StaticResource LiveButtonLabel}">
                                <Binding Path="IsSetMode" />
                                <Binding Path="Output.IsBlank" />
                                <Binding Path="IsSongSearch" />
                            </MultiBinding>
                        </Button.Content>
                    </Button>
                    <Button Content="◀ Prev" Command="{Binding PrevVerseCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,10" />
                    <Button Content="Next ▶" Command="{Binding NextVerseCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,10" />
                    <!-- Last on purpose: the ending action, lowest-frequency click of the four. The loud "on air" red
                         is lit only while something is actually live. Also Escape (Window.InputBindings).
                         Hidden in Set mode, where the "Present Set"/"End Presentation" button above covers this. -->
                    <Button Style="{StaticResource LiveButton}" Command="{Binding StopCommand}" Content="Stop"
                            Visibility="{Binding IsSetMode, Converter={StaticResource InverseBoolToVisibility}}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0" />
                </StackPanel>
            </Border>

            <!-- Drag to resize the live rail wider or narrower; dragging left grows it, right shrinks it. -->
            <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" ResizeBehavior="PreviousAndCurrent" />
        </Grid>
    </Grid>
</Window>
