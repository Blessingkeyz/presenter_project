<Window x:Class="BiblePresenter.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beacon Worship" Width="360" Height="220"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Background="#FF14110F">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/Resources/Styles.xaml" />
    </Window.Resources>

    <Border BorderBrush="{StaticResource Border}" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image x:Name="Mark" Source="pack://application:,,,/BiblePresenter.App;component/Resources/AppIcon.png"
                   Width="56" Height="56" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.55" Duration="0:0:1.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
            </Image>
            <TextBlock Text="Beacon Worship" FontFamily="pack://application:,,,/Resources/Fonts/#Helvetica LT"
                       FontSize="21" Foreground="{StaticResource Parchment}" HorizontalAlignment="Center" Margin="0,0,0,10" />
            <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="{StaticResource Faint}"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
