<Window x:Class="BiblePresenter.App.Views.SongEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Song" Icon="pack://application:,,,/BiblePresenter.App;component/Resources/AppIcon32.png"
        Width="940" Height="720" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <DockPanel Margin="24,18,24,18">
        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0" Padding="0,14,0,0"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" />
                    <Button x:Name="SetOnlyButton" Content="Save for this set only" Margin="8,0,0,0" Click="SetOnly_Click" Visibility="Collapsed" />
                    <Button x:Name="SaveAsNewButton" Content="Save as new song" Margin="8,0,0,0" Click="SaveAsNew_Click" />
                    <Button x:Name="OverwriteButton" Content="Save" Margin="8,0,0,0" Click="Overwrite_Click" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="Hint" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,24,0" />
            </DockPanel>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Title" Style="{StaticResource EditorLabel}" />
                <TextBox x:Name="TitleBox" FontSize="16" VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Author" Style="{StaticResource EditorLabel}" />
                <TextBox x:Name="AuthorBox" VerticalContentAlignment="Center" />
            </StackPanel>
        </Grid>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="+ Verse" Click="AddVerse_Click" />
                <Button Content="+ Chorus" Click="AddChorus_Click" />
                <Button Content="+ Bridge" Click="AddBridge_Click" />
                <Button Content="+ Other" Click="AddOther_Click" Margin="0" />
            </StackPanel>
            <TextBlock Text="Sections" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
            <ItemsControl x:Name="SectionsList" AllowDrop="True"
                          PreviewMouseLeftButtonDown="Sections_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="Sections_PreviewMouseMove"
                          DragOver="Sections_DragOver" Drop="Sections_Drop">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource RemoveXButton}" Margin="10,0,0,0"
                                            Content="&#xE711;" ToolTip="Remove section" AutomationProperties.Name="Remove section"
                                            Click="RemoveSection_Click" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource RemoveXButton}" Margin="4,0,0,0"
                                            Foreground="{StaticResource FadedInk}" Content="&#xE8C8;"
                                            ToolTip="Duplicate section" AutomationProperties.Name="Duplicate section"
                                            Click="DuplicateSection_Click" />
                                    <TextBlock Tag="grip" DockPanel.Dock="Left" Text="&#x22EE;&#x22EE;" FontSize="15" Margin="0,0,14,0"
                                               Foreground="{StaticResource Faint}" Cursor="SizeAll" VerticalAlignment="Center"
                                               ToolTip="Drag to reorder" />
                                    <TextBox DockPanel.Dock="Left" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                             Width="76" HorizontalAlignment="Left" Padding="8,5" VerticalContentAlignment="Center"
                                             FontWeight="SemiBold" Foreground="{StaticResource Candle}"
                                             AutomationProperties.Name="Section label" />
                                </DockPanel>
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" FontSize="15"
                                         VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Section lyrics" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
