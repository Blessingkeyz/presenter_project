<Window x:Class="BiblePresenter.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" Icon="pack://application:,,,/BiblePresenter.App;component/Resources/AppIcon32.png" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}">
    <StackPanel Margin="24,22,24,20">
        <TextBlock x:Name="MessageText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock x:Name="DetailText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,22" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- Cancel is the default (Enter) so a stray keypress never deletes anything. -->
            <Button Content="Cancel" IsDefault="True" IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="ConfirmButton" Style="{StaticResource DangerButton}" Click="Confirm_Click" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
